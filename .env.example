# Copy to .env on the server. Never commit real values.
# Do not paste these secrets into chat.

ASBS_ENV=staging
# Local default. A host such as Render sets PORT; the server uses PORT when it is present.
ASBS_HOST=127.0.0.1
ASBS_PORT=8787
ASBS_DATA_DIR=./data
ASBS_TIMEZONE=America/Chicago
ASBS_MIN_NOTICE_HOURS=24
ASBS_BUFFER_MINUTES=15
# The server offers weekday times through 365 days ahead. A smaller value shortens that window.
ASBS_SLOT_DAYS=365

# Required before the private dashboard will accept a sign-in.
# Choose both values yourself. Leave them blank in git.
ASBS_DASHBOARD_PASSWORD=
ASBS_SESSION_SECRET=
# Set to 1 when the site is served over HTTPS.
ASBS_COOKIE_SECURE=

# Google Calendar. Leave blank until the owner completes OAuth.
# Scopes: https://www.googleapis.com/auth/calendar.readonly and
# https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Confirmation email. This is a second refresh token, issued while signed in to
# americanstandardsolutions@gmail.com, with only the gmail.send scope.
# Do not replace GOOGLE_REFRESH_TOKEN with this value. The calendar token
# belongs to the calendar owner and cannot send as the business mailbox.
# Leave blank until that token exists. See docs/EMAIL_SETUP.md.
GOOGLE_GMAIL_REFRESH_TOKEN=

# Optional. Public measurement id only, for example G-XXXX. Not a secret.
ASBS_GA_MEASUREMENT_ID=
