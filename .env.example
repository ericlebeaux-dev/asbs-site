# Copy to .env on the server. Never commit real values.
# Do not paste these secrets into chat.

ASBS_ENV=staging
# Local default. A host such as Render sets PORT; the server uses PORT when it is present.
ASBS_HOST=127.0.0.1
ASBS_PORT=8787
ASBS_DATA_DIR=./data
ASBS_TIMEZONE=America/Chicago
ASBS_MIN_NOTICE_HOURS=24
ASBS_BUFFER_MINUTES=15
# The server offers weekday times through 365 days ahead. A smaller value shortens that window.
ASBS_SLOT_DAYS=365

# Required before the private dashboard will accept a sign-in.
# Choose both values yourself. Leave them blank in git.
ASBS_DASHBOARD_PASSWORD=
ASBS_SESSION_SECRET=
# Set to 1 when the site is served over HTTPS.
ASBS_COOKIE_SECURE=

# Google Calendar. Leave blank until the owner completes OAuth.
# Scopes: https://www.googleapis.com/auth/calendar.readonly and
# https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Confirmation email. This is a second refresh token, issued while signed in to
# americanstandardsolutions@gmail.com, with only the gmail.send scope.
# Do not replace GOOGLE_REFRESH_TOKEN with this value. The calendar token
# belongs to the calendar owner and cannot send as the business mailbox.
# Leave blank until that token exists. See docs/EMAIL_SETUP.md.
GOOGLE_GMAIL_REFRESH_TOKEN=
# Where new intake notices are delivered. Defaults to the business Gmail above.
ASBS_NOTIFY_EMAIL=americanstandardsolutions@gmail.com
# Visitor confirmation emails stay off. Alerts go only to the mailbox above.
# Set to 1 only after outbound mail to the person who submitted the form is allowed.
# ASBS_CUSTOMER_CONFIRMATIONS=1

# Optional. Public measurement id only, for example G-XXXX. Not a secret.
ASBS_GA_MEASUREMENT_ID=

# Optional. Public HubSpot form ids. Not secrets. The server has these defaults.
HUBSPOT_PORTAL_ID=247883336
HUBSPOT_FORM_GUID=2f694034-1873-43f6-b6f8-f57264d7c5f8

# Optional Cloudflare Turnstile. Leave both blank to keep the honeypot only.
# The site key is public. The secret stays on the server and is not a default.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Document upload page. Leave POC_PAGE_ENABLED unset so /poc/onboarding stays off.
# POC_PAGE_ENABLED=1
# The API receives the file and writes it. The bucket does not need CORS origins.
# DOCS_ENABLED=1
# DOCS_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# DOCS_S3_REGION=us-west-004
# DOCS_S3_BUCKET=
# DOCS_S3_KEY_ID=
# DOCS_S3_SECRET=
# DOCS_MAX_BYTES=10485760
# DOCUMENSO_API_TOKEN=
# DOCUMENSO_TEMPLATE_ID=
# DOCUMENSO_BASE_URL=https://app.documenso.com/api/v2
# DOCUMENSO_DELETE_COMPLETED=0

# Private Google Sheet for intake documents and partner rows.
# The writer does nothing until GOOGLE_SHEETS_REFRESH_TOKEN is set.
# It uses the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as Calendar.
# Until SHEETS_LIVE_WRITES=1, every row is labeled Source "TEST staging"
# and the Company cell is prefixed with [TEST].
GOOGLE_SHEETS_REFRESH_TOKEN=
SHEETS_LIBRARY_ID=11sOtEsVOixlTSWpqMEHWz9lcewtume7-QM6a0W2DqNY
# SHEETS_LIVE_WRITES=1

# Auto-deploy probe comment. This line does not change the running server.
